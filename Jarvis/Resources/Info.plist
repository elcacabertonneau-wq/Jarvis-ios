<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>JARVIS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>JARVIS utilise la caméra pour analyser des images, scanner du texte et reconnaître des objets.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>JARVIS utilise le microphone pour la reconnaissance vocale et les commandes à la voix.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>JARVIS utilise la reconnaissance vocale pour comprendre vos commandes et questions.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>JARVIS accède au calendrier pour gérer vos événements et rendez-vous.</string>
	<key>NSRemindersUsageDescription</key>
	<string>JARVIS accède aux rappels pour créer et gérer vos rappels.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>JARVIS utilise votre position pour vous fournir des informations météo locales.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>JARVIS accède à votre photothèque pour analyser des images.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>JARVIS utilise Apple Music pour lancer de la musique selon vos demandes.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSFaceIDUsageDescription</key>
	<string>JARVIS peut utiliser Face ID pour sécuriser vos données.</string>
</dict>
</plist>
